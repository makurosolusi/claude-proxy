# ── Anthropic API ─────────────────────────────────────────────────────────────
ANTHROPIC_API_URL=https://api.anthropic.com

# ── Admin auth ────────────────────────────────────────────────────────────────
ADMIN_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── OAuth credentials dir ─────────────────────────────────────────────────────
# In Docker: maps to ./credentials on host via compose volume mount
CLIPROXY_AUTH_DIR=/credentials

# ── User tokens (newline-separated key:limit or key:limit:windowMs) ───────────
TOKENS="sk-user-alice:60000
sk-user-bob:60000"

# ── Optional — defaults shown ─────────────────────────────────────────────────
PORT=8080
WINDOW_MS=18000000
UPSTREAM_HARD_CAP_PCT=95
UPSTREAM_POLL_MS=60000
DB_FILE=/app/state/proxy.db

# ── Dev-only ports ─────────────────────────────────────────────────────────────
# OAuth callback port (browser redirect back to proxy after authorization)
OAUTH_CALLBACK_PORT=54545
# Vite HMR WebSocket port (change if running multiple Bun projects simultaneously)
REACT_DEV_HMR_PORT=24678
