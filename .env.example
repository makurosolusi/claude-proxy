# ── WAJIB (minimum untuk jalan) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/claude_proxy
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=ganti-dengan-output-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPER_ADMIN_EMAILS=email-anda@gmail.com
ADMIN_KEY=ganti-dengan-string-acak-panjang

# ── Direktori credential OAuth Claude (claude-*.json) ─────────────────────────
# Lokal: pakai ./credentials. Docker: mount ke /credentials
CLIPROXY_AUTH_DIR=./credentials

# ── Opsional ──────────────────────────────────────────────────────────────────
PORT=8080
ANTHROPIC_API_URL=https://api.anthropic.com
DEFAULT_TOKEN_LIMIT=40000
WINDOW_MS=18000000
UPSTREAM_HARD_CAP_PCT=95
UPSTREAM_POLL_MS=60000
OAUTH_CALLBACK_PORT=54545
TZ=Asia/Makassar

# Seed token statis saat boot (newline-separated key:limit atau key:limit:windowMs)
# TOKENS="sk-user-alice:60000
# sk-user-bob:60000"

# ── Provider fallback (opsional; Anthropic tidak wajib) ───────────────────────
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# ── Khusus dev ────────────────────────────────────────────────────────────────
# MCP_SECRET=
# REACT_EDITOR=code
