# ── Mode ───────────────────────────────────────────────────────────────────────
# UPSTREAM_MODE: 'cliproxy' (default) or 'direct' (bypass cliproxy, talk to Anthropic directly)
UPSTREAM_MODE=cliproxy

# ── cliproxy mode (only needed when UPSTREAM_MODE=cliproxy) ───────────────────
UPSTREAM=http://host:8317
UPSTREAM_KEY=your-upstream-api-key

# ── direct mode (only needed when UPSTREAM_MODE=direct) ───────────────────────
# CLIPROXY_AUTH_DIR=/cliproxy-auth   # dir containing claude-*.json OAuth credentials
# ANTHROPIC_API_URL=https://api.anthropic.com

# ── Shadow mode (validate direct mode while still serving via cliproxy) ───────
# Set to 'true' to fire-and-forget requests to direct mode and log diffs
SHADOW_DIRECT=false

# ── Auth ───────────────────────────────────────────────────────────────────────
ADMIN_KEY=your-admin-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# ── Token definitions (newline-separated key:limit or key:limit:windowMs) ─────
TOKENS="sk-user-alice:40000
sk-user-bob:40000"

# ── Optional — defaults shown ─────────────────────────────────────────────────
PORT=8080
WINDOW_MS=18000000
UPSTREAM_HARD_CAP_PCT=95
UPSTREAM_POLL_MS=60000
CLIPROXY_AUTH_DIR=/cliproxy-auth
DB_FILE=./state/proxy.db
