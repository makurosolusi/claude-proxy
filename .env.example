# ── Anthropic API ─────────────────────────────────────────────────────────────
ANTHROPIC_API_URL=https://api.anthropic.com

# ── Admin auth ────────────────────────────────────────────────────────────────
ADMIN_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── OAuth credentials dir ─────────────────────────────────────────────────────
# In Docker: maps to ./credentials on host via compose volume mount
CLIPROXY_AUTH_DIR=/credentials

# ── User tokens (newline-separated key:limit or key:limit:windowMs) ───────────
TOKENS="sk-user-alice:60000
sk-user-bob:60000"

# ── Database (PostgreSQL required) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/claude_proxy

# ── Optional — defaults shown ─────────────────────────────────────────────────
PORT=8080
WINDOW_MS=18000000
UPSTREAM_HARD_CAP_PCT=95
UPSTREAM_POLL_MS=60000
