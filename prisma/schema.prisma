generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ── Application tables ────────────────────────────────────────────────────────

model tokens {
  key          String   @id
  user_id      String   @default("")
  lim          BigInt?
  win          BigInt
  used         BigInt   @default(0)
  window_start BigInt
  paused       Boolean  @default(false)
  dynamic      Boolean  @default(false)
  deleted      Boolean  @default(false)
  provider     String   @default("inherit")
  label        String   @default("")
  description  String   @default("")
  pinned_model String   @default("")
  // Quota reset behavior. "manual" (default for new tokens) = never auto-reset,
  // admin must reset or raise limit. "auto" = legacy rolling-window behavior
  // (resets every window_ms, also resets when Anthropic 5h window rotates).
  // "daily" = reset at local midnight only, independent of Anthropic.
  // Existing tokens are migrated to "auto" so behavior is preserved on upgrade.
  reset_mode   String   @default("manual")
  last_reset   BigInt?
}

model request_logs {
  id              Int     @id @default(autoincrement())
  ts              BigInt
  token_key       String
  name            String  @default("")
  user_id         String  @default("")
  model           String  @default("")
  input_tokens    Int     @default(0)
  output_tokens   Int     @default(0)
  cache_read      Int     @default(0)
  cache_creation  Int     @default(0)
  stream          Boolean @default(false)
  status          Int     @default(200)
  stop_reason     String  @default("")
  tool_use_count  Int     @default(0)
  duration_ms     Int     @default(0)
  turns           Int     @default(0)
  prompt          String  @default("")
  system_prompt   String  @default("")
  messages_json   String  @default("")
  response_text   String  @default("")

  @@index([ts(sort: Desc)], name: "idx_rl_ts")
  @@index([token_key, ts(sort: Desc)], name: "idx_rl_key")
}

model daily_usage {
  date      String
  token_key String
  user_id   String @default("")
  used      Int    @default(0)

  @@id([date, token_key])
}

model upstream_state {
  id                   Int     @id @default(1)
  last_known_resets_at String?
  detected_window_ms   BigInt?
  last_poll            BigInt?
  five_hour_util       Float?
  five_hour_resets_at  String?
  seven_day_util       Float?
  seven_day_resets_at  String?
  sonnet_util          Float?
  sonnet_resets_at     String?
  opus_util            Float?
  opus_resets_at       String?
}

model users {
  id                    String  @id
  name                  String
  email                 String  @default("")
  description           String  @default("")
  created_at            BigInt
  role                  String  @default("USER")
  status                String  @default("pending")
  context_blocked_at       BigInt?
  context_block_reason     String?
  context_block_grace_until BigInt?
}

model settings {
  key   String @id
  value String
}

model extensions {
  id           String  @id
  name         String  @default("")
  version      String  @default("0.0.0")
  enabled      Boolean @default(false)
  config       String  @default("{}")
  installed_at BigInt  @default(0)
  updated_at   BigInt  @default(0)
}

model admin_notifications {
  id          String  @id
  message     String
  created_at  BigInt
  created_by  String  @default("")
  target_type String  @default("all")
  target_ids  String  @default("")
  deleted     Boolean @default(false)
  deliver_via String  @default("web")    // "web" | "terminal" | "both"
  priority    String  @default("info")   // "info" | "warning" | "critical"

  @@index([deleted, created_at(sort: Desc)], name: "idx_admin_notif_active")
}

model notification_dismissals {
  notification_id String
  user_id         String
  dismissed_at    BigInt

  @@id([notification_id, user_id])
  @@index([user_id], name: "idx_notif_dismiss_user")
}

// Tracks which user has seen which notification via terminal injection.
// Separate from notification_dismissals so terminal delivery doesn't auto-close
// the web modal (and vice versa). Each (notification, user) pair gets a single
// row when the announcement is first injected into a /v1/messages response.
model notification_terminal_deliveries {
  notification_id String
  user_id         String
  delivered_at    BigInt

  @@id([notification_id, user_id])
  @@index([user_id], name: "idx_notif_term_user")
}

// ── Better Auth tables ────────────────────────────────────────────────────────

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String    @default("USER")
  sessions      session[]
  accounts      account[]
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}
