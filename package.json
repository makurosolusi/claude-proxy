{
  "name": "claude-proxy",
  "version": "2.0.0",
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "build": "bun build ./src/index.html --outdir=dist --target=browser --minify",
    "start": "NODE_ENV=production bun src/index.tsx",
    "test": "bun test tests/",
    "test:unit": "bun test tests/unit.test.ts",
    "test:integration": "bun test tests/server.test.ts",
    "test:watch": "bun test --watch tests/"
  },
  "dependencies": {
    "@mantine/core": "^9.1.1",
    "@mantine/hooks": "^9.1.1",
    "@tabler/icons-react": "^3.41.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
}
