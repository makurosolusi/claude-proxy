{
  "mcpServers": {
    "deploy-stg": {
      "command": "bun",
      "args": ["run", "scripts/mcp/deploy.ts"],
      "description": "Deploy claude-proxy ke staging: stg branch → GHCR → Portainer (claude-proxy-stg)",
      "env": {
        "STACK_NAME": "claude-proxy",
        "BASE_URL": "https://claude-proxy.wibudev.com",
        "ENV": "stg",
        "GH_TOKEN": "${GH_TOKEN}",
        "GH_REPO": "bipprojectbali/claude-proxy"
      }
    },
    "debug-stg": {
      "command": "bun",
      "args": ["run", "scripts/mcp/debug-stg.ts"],
      "description": "Debug staging runtime: query DB, cek logs, status, dan inspeksi token langsung dari local",
      "env": {
        "BASE_URL": "https://claude-proxy.wibudev.com",
        "MCP_SECRET": "${MCP_SECRET}"
      }
    },
    "debug-dev": {
      "command": "bun",
      "args": ["run", "scripts/mcp/debug-dev.ts"],
      "description": "Debug runtime local (dev): inspect logs, DB, users, sessions, quota — langsung ke localhost:8080",
      "env": {
        "BASE_URL": "http://localhost:3000",
        "MCP_SECRET": "${MCP_SECRET}",
        "DATABASE_URL": "${DATABASE_URL}"
      }
    }
  }
}
